# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# Trained models — large binary files, retrain locally
models/*.pkl

# Logs
logs/

# Conda / virtualenv
.conda/
venv/
env/

# macOS
.DS_Store
.AppleDouble

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# Dashboard — Node dependencies and Next.js build output
dashboard/node_modules/
dashboard/.next/
dashboard/.vercel/
dashboard/out/

# Vercel project metadata (contains project ID, not secret but not useful to commit)
.vercel/
